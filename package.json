{
  "name": "hls-dash-live-sim",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Standalone HLS and DASH live manifest simulation and fault injection",
  "type": "commonjs",
  "bin": {
    "hls-dash-live-sim": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdaci23/hls-dash-live-sim.git"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/copyStaticAssets.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "livesim": "node dist/cli.js livesim",
    "hls": "node dist/cli.js livesim start --sim-type hls",
    "dash": "node dist/cli.js livesim start --sim-type dash --detach",
    "templates": "node dist/cli.js list-manifest-templates",
    "fault-control": "node dist/cli.js fault-control",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:docker": "npm run build && node scripts/run-docker-tests.cjs",
    "fixtures": "node scripts/generate-fixtures.cjs && node scripts/generate-dash-abr.cjs",
    "fixtures:dash-abr": "node scripts/generate-dash-abr.cjs",
    "scenario:verify": "npm run build && node scripts/verify-scenarios.cjs",
    "browser:verify": "npm run build && node scripts/verify-browser.cjs",
    "roku:build": "bsc --project roku/bsconfig.json",
    "roku:verify": "npm run build && node scripts/verify-roku.cjs",
    "roku:deploy": "npm run roku:build && node scripts/deploy-roku.cjs",
    "roku:suite": "npm run build && node scripts/verify-roku-suite.cjs",
    "test:ui": "npm run build && node scripts/run-ui-tests.cjs",
    "docs:check": "node scripts/check-docs.cjs",
    "test:package": "npm run build && node scripts/verify-package.cjs",
    "browser:abr": "npm run build && node scripts/verify-hls-abr.cjs",
    "browser:outage": "npm run build && node scripts/verify-browser.cjs --case outage",
    "manifest:verify": "npm run build && node scripts/verify-manifest-freeze.cjs",
    "browser:dash-abr": "npm run build && node scripts/verify-dash-abr.cjs",
    "browser:dash-fallback": "npm run build && node scripts/verify-dash-abr.cjs --case fallback",
    "network:verify": "npm run build && node scripts/verify-network-scenarios.cjs",
    "notices:generate": "node scripts/third-party-notices.cjs --write",
    "notices:check": "node scripts/third-party-notices.cjs",
    "release:review": "node scripts/release-review.cjs",
    "transport:verify": "npm run build && node scripts/verify-transport-scenarios.cjs",
    "retry:verify": "npm run build && node scripts/verify-multi-retry.cjs",
    "audio:verify": "npm run build && node scripts/verify-dash-audio-outage.cjs",
    "rendition:verify": "npm run build && node scripts/verify-rendition-outages.cjs",
    "network:presets": "npm run build && node scripts/verify-network-presets.cjs",
    "resource:verify": "npm run build && node scripts/verify-resource-scenarios.cjs",
    "controls:verify": "npm run build && node scripts/verify-scenario-controls.cjs",
    "faults:verify": "npm run build && node scripts/verify-core-faults.cjs",
    "browser:core": "npm run build && node scripts/verify-core-browser.cjs",
    "http:verify": "npm run build && node scripts/verify-http-policy.cjs",
    "headers:verify": "npm run build && node scripts/verify-status-headers.cjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "fast-xml-parser": "^5.11.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.5.2",
    "@types/yargs": "^17.0.33",
    "brighterscript": "0.73.8",
    "dashjs": "5.2.1",
    "hls.js": "1.7.3",
    "playwright": "1.64.1",
    "roku-deploy": "3.18.4",
    "typescript": "5.2.2"
  },
  "files": [
    "dist",
    "assets",
    "examples",
    "README.md",
    "CONTRIBUTING.md",
    "docs",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "third-party",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
